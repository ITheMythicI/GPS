[Unit]
Description=BIN AI Microservicio (Flask)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/backend-repo/backend/ai/microservicio
ExecStart=/home/ubuntu/backend-repo/backend/ai/microservicio/venv/bin/python app.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
